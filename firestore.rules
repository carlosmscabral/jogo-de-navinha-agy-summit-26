rules_version = '2';

// Modelo de segurança da Spec 05 §6: leitura pública das três coleções do
// placar, escrita negada a todo cliente. A única escrita do sistema vem do
// Cloud Run com o Admin SDK, que ignora estas regras por definição.
service cloud.firestore {
  match /databases/{database}/documents {

    match /matches/{matchId} {
      allow read: if true;
      allow write: if false;
    }

    match /pilots/{pilotId} {
      allow read: if true;
      allow write: if false;
    }

    match /company_rankings/{company} {
      allow read: if true;
      allow write: if false;
    }

    // Tarefa C7: catálogo de empresas, agora também no Firestore (companies/catalog).
    // Leitura pública porque o estande pode querer buscá-lo; escrita negada como as
    // outras três — o painel de admin escreve pelo Admin SDK, que ignora estas regras.
    match /companies/{companyDoc} {
      allow read: if true;
      allow write: if false;
    }

    // Lease da varredura de canonicalização (system/canonicalization_lease). Ao contrário das
    // coleções acima, NADA aqui é público: é estado interno de coordenação entre instâncias do
    // Cloud Run, sem nenhum uso para o placar ou para o estande. O Admin SDK ignora estas regras.
    match /system/{doc} {
      allow read, write: if false;
    }

    // Catch-all. Tudo que não está declarado acima cai aqui e fica negado a todo cliente —
    // inclusive `company_aliases`, que EXISTE em produção (escrita pelo Admin SDK em
    // canonicalize.ts) e deliberadamente não tem regra própria: ao contrário do placar, ela
    // não tem leitor público. Uma coleção que precise de leitura pública tem de ser declarada
    // aqui em cima, de propósito.
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
