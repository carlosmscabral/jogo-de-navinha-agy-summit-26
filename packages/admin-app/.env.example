# Em produção, o admin-app é servido pelo MESMO container Cloud Run da cloud-api, sob
# /admin (Tarefa C7) — deixe vazio para que as chamadas a /v1/admin/* usem a própria
# origem. Preencha apenas para rodar `npm run dev` local contra uma cloud-api em outra
# porta/host.
VITE_CLOUD_API_BASE=

# Config do projeto Firebase, só para a tela Rankings (leitura direta de
# company_rankings via SDK cliente, mesmo padrão do leaderboard-app — Tarefa C6).
VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=
VITE_FIREBASE_PROJECT_ID=
VITE_FIREBASE_STORAGE_BUCKET=
VITE_FIREBASE_MESSAGING_SENDER_ID=
VITE_FIREBASE_APP_ID=
