{
  "name": "@jogo/cloud-api",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "build": "tsc",
    "start": "node dist/index.js",
    "test": "tsc && cd ../.. && node --test packages/cloud-api/dist/firestore-rules.test.js packages/cloud-api/dist/auth.test.js packages/cloud-api/dist/ingest.test.js",
    "vendor:shared": "rm -rf vendor && mkdir -p vendor/jogo-shared && cp -R ../shared/dist ../shared/package.json vendor/jogo-shared/"
  },
  "dependencies": {
    "@jogo/shared": "*",
    "express": "^5.2.1",
    "firebase-admin": "^14.3.0",
    "ajv": "^8.17.1",
    "ajv-formats": "^3.0.1",
    "zod": "^3.24.2"
  },
  "devDependencies": {
    "@firebase/rules-unit-testing": "^5.0.2",
    "@types/express": "^5.0.0",
    "@types/node": "^22.13.4",
    "typescript": "^5.7.3"
  }
}
