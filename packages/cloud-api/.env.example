# Porta HTTP. O Cloud Run injeta a sua própria automaticamente; só é preciso
# definir isto rodando localmente.
PORT=8080

# Token de posse única para POST /v1/matches (Spec 08 §6.1). Sem isto configurado,
# isAuthorized() recusa toda requisição — ver src/auth.ts. Em produção vem do Secret
# Manager via --set-secrets, nunca de um arquivo .env commitado.
BOOTH_INGEST_TOKEN=

# Apontar para o emulador local em vez do Firestore real. Deixe vazio em produção.
FIRESTORE_EMULATOR_HOST=

# ID do projeto Google Cloud usado pelo cliente Vertex AI (vertex.ts) — moderação de
# camada 2 e canonicalização (Tarefa C4). Obrigatório em produção: sem isto, o serviço
# recusa subir (ver index.ts). Nunca é lido pelos testes, que injetam `generate`.
GOOGLE_CLOUD_PROJECT=

# Região do Vertex AI. Deixe em 'global' — é a única região que serve gemini-3.7-flash
# hoje (ver vertex.ts, Passo 1). Não defina para uma região tipo us-central1: quebra em
# runtime.
VERTEX_LOCATION=global

# Tempo máximo (ms) que POST /v1/moderate espera pelo modelo antes de falhar fechado
# (Spec 05 §3.2). Default 1500 se ausente/inválido.
MODERATION_L2_TIMEOUT_MS=1500

# Senha HTTP Basic na frente de /v1/admin/* e do painel /admin (Tarefa C10), em cima do
# Identity-Aware Proxy (configuração de deploy, não afetada por esta variável). Sem isto
# configurado, isAdminAuthorized() recusa toda requisição administrativa — ver
# src/admin-auth.ts. Em produção vem do Secret Manager via --set-secrets, nunca de um
# arquivo .env commitado. Qualquer usuário serve no prompt do navegador; só a senha é
# checada.
ADMIN_PANEL_PASSWORD=
