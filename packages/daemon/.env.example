# Copie para `.env` neste diretório e preencha. `npm run start`/`dev` (Node ≥20.12/21.7,
# `--env-file-if-exists`) carrega este arquivo sozinho — não precisa exportar nada na mão.
# Achado ao vivo, 2026-08-24: antes desta linha, `npm run start:daemon` era só `node
# dist/index.js`, sem nenhum mecanismo de carregar `.env` — criar o arquivo não bastava,
# e `/api/sync/status` mostrava `"state": "disabled"` mesmo com as variáveis preenchidas.

# Qual estande é este. Vai carimbado em toda partida e é o que o painel de Saúde usa para
# agrupar "de qual Mac veio isso" — com dois estandes jogando contra o mesmo placar, é a
# diferença entre "as partidas pararam" e "o Mac B travou". Só letras, números, ponto, hífen
# e sublinhado (até 64 caracteres); um valor fora disso é recusado com aviso no boot.
# Ausente, o daemon usa o hostname da máquina e loga qual nome adotou — nunca falha o boot
# por causa disto. Sugestão: booth-a num Mac, booth-b no outro.
BOOTH_STATION_ID=

# Caminho alternativo para o catálogo de empresas (config/companies.json por padrão).
# ATENÇÃO: este arquivo deixou de ser a fonte de verdade. Ele é a SEMENTE do primeiro boot e a
# rede de segurança de um estande que sobe sem rede; com a nuvem configurada, o catálogo passa a
# vir de `GET /v1/companies` (o documento que o painel de admin edita) e o daemon espelha aquela
# lista, remoções inclusive. Editar o arquivo aqui não muda mais nada depois do primeiro pull.
BOOTH_COMPANIES_FILE=

# De quanto em quanto tempo o estande puxa catálogo e aliases da nuvem, em ms (default 120000).
# O primeiro tick sai com jitter para os dois Macs, ligados pelo mesmo script, não baterem juntos.
BOOTH_CATALOG_SYNC_INTERVAL_MS=

# Escape para uma poda GRANDE e intencional do catálogo. Por padrão, o daemon recusa aplicar um
# pull em que mais de 30% das empresas somem de uma vez — o caso que isso impede é banal e caro:
# um "Salvar" no painel com a lista truncada esvaziando as DUAS estações a 40 minutos de abrir o
# estande. Ligue (=1), deixe o pull acontecer, e desligue de novo.
BOOTH_CATALOG_ALLOW_MASS_REMOVAL=

# URL base da API de ingestão em Cloud Run (Tarefa C3+), ex.: https://jogo-navinha-api-xxx.run.app.
# Deixe vazio para rodar sem nuvem (modo 100% local) — moderação de camada 2 e sincronização
# de partidas ficam desligadas nesse caso, sem erro.
BOOTH_CLOUD_API_BASE=

# Mesmo token de posse única que a cloud-api espera em `Authorization: Bearer` (ver
# packages/cloud-api/.env.example, BOOTH_INGEST_TOKEN). Sem isto, POST /v1/moderate e
# POST /v1/matches são recusados com 401 — o daemon trata isso como nuvem indisponível
# (fail-open na moderação, fila de sincronização local intacta).
BOOTH_INGEST_TOKEN=

# Tempo máximo (ms) que o daemon espera pela moderação de camada 2 (POST /v1/moderate)
# antes de seguir só com a aprovação local (fail-open). Default 25000 se ausente/inválido.
# Tem que ser MAIOR que o MODERATION_L2_TIMEOUT_MS da cloud-api (hoje 20000): o cronômetro
# daqui começa antes do hop até o Cloud Run, então empatar os dois faz o abort local vencer
# sempre e o fail-closed do servidor nunca chegar aqui (achado ao vivo, Gate M3 2026-08-24).
#
# NINGUÉM espera por este tempo. Desde 2026-08-24 a camada 2 roda em segundo plano
# (packages/daemon/src/services/pending-moderation.ts): ela é disparada no /api/session/start e
# colhida lá na frente, no /api/matches, depois da forja e da partida. Este teto não é orçamento
# de paciência do visitante, é só o limite de quanto a resposta pode demorar antes de importar.
BOOTH_MODERATION_L2_TIMEOUT_MS=25000

# --- Caminhos (raramente preenchidos; os defaults servem ao estande) -------------------------

# Onde o daemon procura o build do player-app para servir na porta 3000. Default: o
# `packages/player-app/dist` do próprio monorepo, resolvido relativo ao `dist/` do daemon.
# Só é preciso definir quando o daemon roda fora do layout do repositório (imagem, pacote
# copiado). Se o caminho não tiver um `index.html`, o daemon sobe assim mesmo e só loga aviso:
# a API da sessão funciona e a Tela 1 fica sem ser servida.
BOOTH_PLAYER_APP_DIST=

# Diretório do workspace efêmero da sessão (flag `.session_active`, `.agy_pid`, `GEMINI.md`,
# `.agents/`, `mcp_audit.log`, `ship_spec.json`). Default `/tmp/booth_session`.
# CUIDADO: mudar isto aqui NÃO basta. O supervisor da Tela 2 tem o caminho fixo em
# `scripts/booth-terminal.sh:15`, e os servidores MCP leem a variável por conta própria, do
# ambiente em que o `agy` foi iniciado (`packages/mcps/src/utils/audit-logger.ts:6`) — que é o
# terminal, não o daemon. Definir só do lado do daemon quebra o estande em silêncio: o
# supervisor espera por uma flag que nunca aparece e a telemetria de MCP nunca chega à Tela 1.
# É variável de desenvolvimento, para rodar dois daemons na mesma máquina sem um pisar no outro.
BOOTH_SESSION_DIR=

# Caminho do buffer SQLite de partidas. Default `packages/daemon/data/booth_buffer.sqlite`,
# resolvido a partir da raiz do pacote — ou seja, NÃO depende do diretório de onde você
# iniciou o daemon. O diretório é criado se não existir. `npm run reset:db` apaga o default.
BOOTH_DB_PATH=

# `=1` insere pilotos fictícios no placar local na criação do banco. É opt-in explícito
# justamente porque ninguém quer descobrir um "NEBULA_RIDER" no telão no meio do evento.
# NUNCA no dia do evento. Qualquer outro valor (inclusive vazio) não faz nada.
BOOTH_SEED_DEMO=

# --- Relógios do fallback do agy (Spec 06 §1.1) ---------------------------------------------
# Quatro gatilhos independentes; o primeiro que disparar injeta um preset e encerra o `agy`.
# Todos aceitam override por ambiente, mas mexa neles em conjunto: existe uma invariante entre
# o teto rígido e a soma das fases (ver comentário em src/index.ts).

# Da abertura da sessão até a PRIMEIRA chamada de ferramenta MCP. Não é silêncio de verdade: o
# daemon não enxerga a conversa do Fast-Grill-Me, então este relógio é armado uma vez e nunca
# rearmado nessa fase. Cobre o visitante lendo/respondendo duas perguntas E o modelo pensando.
AGY_PRE_MCP_SILENCE_TIMEOUT_MS=135000

# Silêncio entre chamadas de MCP, DEPOIS da primeira. Aqui o ritmo é de máquina (o agente
# encadeia tools sozinho), então 30s parado é travamento de verdade, não gente pensando.
AGY_SILENCE_TIMEOUT_MS=30000

# Silêncio depois que o gate de auditoria MCP foi satisfeito — fase dos sub-agentes narrativos
# e visuais, que são legitimamente mais lentos.
AGY_POST_AUDIT_TIMEOUT_MS=90000

# Teto absoluto desde `.session_active`, armado uma vez e nunca rearmado.
# INVARIANTE: >= AGY_PRE_MCP_SILENCE_TIMEOUT_MS + AGY_POST_AUDIT_TIMEOUT_MS (135000 + 90000).
# Abaixo disso, uma sessão que progride dentro de cada janela de fase ainda assim morre aqui.
AGY_HARD_TIMEOUT_MS=225000
