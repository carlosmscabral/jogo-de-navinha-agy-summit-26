# Deixe VAZIO em produção: aponta o telão para o bridge local como rede de segurança
# (Spec 05 §7.2). Preencha apenas para rodar `npm run dev:leaderboard` com o Vite em
# outra porta, ou para apontar a um bridge remoto durante testes.
VITE_BRIDGE_BASE=http://localhost:3000

# Endereço da API de ingestão em Cloud Run, consumido pela Tarefa C3+. Deixe vazio
# enquanto o app não fala com a nuvem.
VITE_CLOUD_API_BASE=

# Config do projeto Firebase, consumida pela Tarefa C6 para assinar o Firestore via
# onSnapshot. Copie os valores do console do Firebase (Configurações do projeto > Seus apps).
VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=
VITE_FIREBASE_PROJECT_ID=
VITE_FIREBASE_STORAGE_BUCKET=
VITE_FIREBASE_MESSAGING_SENDER_ID=
VITE_FIREBASE_APP_ID=
